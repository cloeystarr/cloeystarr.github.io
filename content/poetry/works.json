  {
    "id": "poetry-04",
    "slug": "where-do-memories-live",
    "historical_number": "4",
    "text": "Where do memories live? A smell of fabric that touched both me\nand you triggers a marathon of memories. Seductive suction the\npresent moment disappears and I'm in a reconstructed past\npackaging the most suitable version for you.",
    "text_sha256": "bcb5a92ab8670c9f8209137ffbda6f11887956f674bb19c12ab4fb43223d025d",
    "author": "Chloe Starr",
